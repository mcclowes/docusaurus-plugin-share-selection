{
  "name": "docusaurus-plugin-share-selection",
  "version": "0.1.0",
  "description": "A Docusaurus plugin that shows a share palette when readers highlight text: copy for Slack or Teams, ask an AI with page context, or share, all with deep links to the exact passage.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "check:exports": "npm run build && attw --pack --profile node16 .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "example:start": "npm --prefix examples/docusaurus-v3 run start",
    "example:build": "npm --prefix examples/docusaurus-v3 run build",
    "example:serve": "npm --prefix examples/docusaurus-v3 run serve",
    "prepare": "husky",
    "prepublishOnly": "npm run build && npm test && npm run check:exports",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "lint": "eslint \"src/**/*.ts\" \"e2e/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"e2e/**/*.ts\" --fix"
  },
  "keywords": [
    "docusaurus",
    "docusaurus-plugin",
    "share",
    "selection",
    "highlight",
    "text-fragments",
    "slack",
    "ai",
    "llm"
  ],
  "author": "mcclowes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcclowes/docusaurus-plugin-share-selection.git"
  },
  "bugs": {
    "url": "https://github.com/mcclowes/docusaurus-plugin-share-selection/issues"
  },
  "homepage": "https://github.com/mcclowes/docusaurus-plugin-share-selection#readme",
  "peerDependencies": {
    "@docusaurus/core": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
